<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>${og_title}</title>

<meta property="og:type" content="website">
<meta property="og:site_name" content="defcon.run">
<meta property="og:url" content="${page_url}">
<meta property="og:title" content="${og_title}">
<meta property="og:description" content="${og_description}">
<meta property="og:image" content="${og_image}">
<meta property="og:image:secure_url" content="${og_image}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="${og_title}">
<meta name="twitter:description" content="${og_description}">
<meta name="twitter:image" content="${og_image}">

<!-- Human redirect: fires before render (no visible page); meta-refresh is the no-JS fallback. -->
<meta http-equiv="refresh" content="0;url=${target_url}">
<script>location.replace(${target_url_json});</script>
<link rel="canonical" href="${target_url}">
<style>
  html,body{height:100%;margin:0;background:#04060d;color:#8fd0ff;
    font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
    display:flex;align-items:center;justify-content:center;text-align:center}
  a{color:#7fe1ff}
</style>
</head>
<body>
  <p>Redirecting&hellip; <a href="${target_url}">click here</a> if you are not redirected.</p>
</body>
</html>
