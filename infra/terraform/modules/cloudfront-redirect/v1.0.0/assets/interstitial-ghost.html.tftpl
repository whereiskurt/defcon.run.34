<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>${og_title}</title>

<meta property="og:type" content="website">
<meta property="og:site_name" content="defcon.run">
<meta property="og:url" content="${page_url}">
<meta property="og:title" content="${og_title}">
<meta property="og:description" content="${og_description}">
<meta property="og:image" content="${og_image}">
<meta property="og:image:secure_url" content="${og_image}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="${og_title}">
<meta name="twitter:description" content="${og_description}">
<meta name="twitter:image" content="${og_image}">

<!-- Ghost splash: full-viewport purple matrix rain (katakana + ghost glyphs)
     behind a floating apparition, a séance log, then we cross over. Same ~1.6s
     beat as the other splashes (so the tab title reads the og_title, not the
     destination). meta-refresh is the no-JS fallback, long enough to never
     preempt the JS.
     NOTE (terraform templatefile): a percent sign immediately followed by an
     open brace is read as a control directive, so CSS percent keyframe
     selectors must double the percent sign. This splash uses from/to keyframes
     to sidestep it entirely — including in this comment, which is also parsed. -->
<meta http-equiv="refresh" content="4;url=${target_url}">
<link rel="canonical" href="${target_url}">
<style>
  :root{ --bg:#0a0a0f; --ink:#e4e4ef; --muted:#a4a4b8; --ghost:#a855f7; --deep:#7c3aed;
         --lav:#d8b4fe; --border:#2a2a3a; --surface:#111118; }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%}
  body{
    background:var(--bg); color:var(--ink); overflow:hidden;
    font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
    display:flex; align-items:center; justify-content:center; text-align:center;
  }
  #rain{position:fixed;inset:0;z-index:0}
  .glow{position:fixed;inset:0;z-index:1;pointer-events:none;background:
    radial-gradient(60% 65% at 50% 42%,rgba(10,10,15,.30),rgba(10,10,15,.62) 82%),
    radial-gradient(55% 60% at 12% 4%,rgba(168,85,247,.16),transparent 62%)}
  .wrap{position:relative;z-index:2;padding:24px;max-width:560px;width:100%}

  .mark{font-size:clamp(22px,6vw,30px);font-weight:800;letter-spacing:-.02em}
  .mark .dot{color:var(--ghost)}
  .kick{margin-top:6px;font-size:clamp(10px,2.8vw,12px);font-weight:800;
    letter-spacing:.30em;color:var(--ghost)}

  /* the apparition: a bobbing ghost with a soft purple aura */
  .ghost{margin:38px auto 0;width:min(120px,32vw);position:relative;
    animation:bob 1.4s ease-in-out infinite alternate;
    filter:drop-shadow(0 0 24px rgba(168,85,247,.55))}
  @keyframes bob{from{transform:translateY(0)}to{transform:translateY(-10px)}}
  .ghost svg{display:block;width:100%;height:auto}
  .shadow{margin:16px auto 0;width:min(90px,24vw);height:10px;border-radius:50%;
    background:radial-gradient(50% 50% at 50% 50%,rgba(124,58,237,.45),transparent 70%);
    animation:shrink 1.4s ease-in-out infinite alternate}
  @keyframes shrink{from{transform:scaleX(1)}to{transform:scaleX(.72)}}

  .log{margin-top:20px;font-family:"JetBrains Mono",ui-monospace,Menlo,monospace;
    font-size:clamp(10px,2.9vw,12px);color:var(--lav);letter-spacing:.02em;
    text-shadow:0 0 6px #a855f766,0 0 14px #a855f733;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .load{margin-top:12px;font-size:clamp(12px,3.4vw,14px);letter-spacing:.18em;color:var(--muted)}
  .bar{margin:12px auto 0;width:min(340px,80vw);height:8px;border:1px solid var(--border);
    border-radius:6px;overflow:hidden;background:rgba(17,17,24,.9)}
  .bar>i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--deep),var(--ghost));
    box-shadow:0 0 14px rgba(168,85,247,.6);animation:fill 1.5s ease-out forwards}
  @keyframes fill{to{width:100%}}
  .foot{margin-top:18px;font-size:12px;letter-spacing:.12em;color:#8f8fa8}
  .foot a{color:var(--ghost);text-decoration:none}
  @media (prefers-reduced-motion:reduce){
    .bar>i{animation:none;width:100%}
    .ghost,.shadow{animation:none}
  }
</style>
</head>
<body>
  <canvas id="rain"></canvas>
  <div class="glow"></div>
  <div class="wrap">
    <div class="mark">defcon<span class="dot">.</span>run</div>
    <div class="kick">DEF CON 34 &middot; THE GHOSTS</div>

    <div class="ghost">
      <svg viewBox="0 0 100 110" aria-hidden="true">
        <path d="M50 4C26 4 12 24 12 48v52c0 4 5 6 8 3l7-7 8 8c2 2 5 2 7 0l8-8 8 8c2 2 5 2 7 0l8-8 7 7c3 3 8 1 8-3V48C88 24 74 4 50 4Z"
          fill="#151022" stroke="#a855f7" stroke-width="3"/>
        <circle cx="37" cy="44" r="7" fill="#a855f7"/>
        <circle cx="63" cy="44" r="7" fill="#a855f7"/>
        <circle cx="39" cy="46" r="2.6" fill="#0a0a0f"/>
        <circle cx="65" cy="46" r="2.6" fill="#0a0a0f"/>
        <path d="M40 62q10 8 20 0" fill="none" stroke="#7c3aed" stroke-width="3" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="shadow"></div>

    <div class="log" id="l">tuning dead channels&hellip;</div>
    <div class="load">SUMMONING&hellip;</div>
    <div class="bar"><i></i></div>
    <div class="foot"><a href="${target_url}">skip &rsaquo;</a> &nbsp;&middot;&nbsp; g.defcon.run</div>
  </div>
<script>
  // Purple matrix rain (katakana + the occasional ghost) under a séance log,
  // then we cross over.
  var TARGET = ${target_url_json};
  var LOG = [
    "tuning dead channels…",
    "EVP capture armed…",
    "5 apparitions detected",
    "séance link established"
  ];
  var l = document.getElementById("l"), t0 = Date.now();
  var tick = setInterval(function () {
    var f = Math.min(1, (Date.now() - t0) / 1500);
    l.textContent = LOG[Math.min(LOG.length - 1, Math.floor(f * LOG.length))];
    if (f >= 1) clearInterval(tick);
  }, 50);

  var cv = document.getElementById("rain"), cx = cv.getContext("2d");
  var GLYPHS = "アイウエオカキクケコサシスセソタチツテトナニヌネノ01".split("");
  GLYPHS.push("\u{1F47B}"); // one ghost in the character soup
  var COL = 16, drops = [], cols = 0;
  function size() {
    cv.width = innerWidth; cv.height = innerHeight;
    cols = Math.ceil(cv.width / COL);
    drops = [];
    for (var i = 0; i < cols; i++) drops.push(Math.floor(Math.random() * (cv.height / COL)) - 10);
  }
  size();
  addEventListener("resize", size);
  var reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  function frame() {
    cx.fillStyle = "rgba(10,10,15,0.10)";
    cx.fillRect(0, 0, cv.width, cv.height);
    cx.font = "14px monospace";
    for (var i = 0; i < cols; i++) {
      var g = GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
      cx.fillStyle = Math.random() < 0.10 ? "#e9d5ff" : "#b06cf7";
      cx.fillText(g, i * COL, drops[i] * COL);
      if (drops[i] * COL > cv.height && Math.random() > 0.975) drops[i] = 0;
      drops[i]++;
    }
  }
  // A short warmup so the very first paint already has rain on it — run even
  // under prefers-reduced-motion (a still frame is static content; only the
  // ongoing animation is motion).
  for (var w = 0; w < 40; w++) frame();
  if (!reduced) {
    var rain = setInterval(frame, 50);
    setTimeout(function () { clearInterval(rain); }, 1600);
  }
  setTimeout(function () { location.replace(TARGET); }, 1600);
</script>
</body>
</html>
