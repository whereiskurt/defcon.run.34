<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>${og_title}</title>

<meta property="og:type" content="website">
<meta property="og:site_name" content="defcon.run">
<meta property="og:url" content="${page_url}">
<meta property="og:title" content="${og_title}">
<meta property="og:description" content="${og_description}">
<meta property="og:image" content="${og_image}">
<meta property="og:image:secure_url" content="${og_image}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="${og_title}">
<meta name="twitter:description" content="${og_description}">
<meta name="twitter:image" content="${og_image}">

<!-- Electronic boot splash: a 3s countdown, then a brief "reveal" beat (so the
     joke lands even for logged-out users who then hit the bib login wall), then
     navigate. meta-refresh is the no-JS fallback, set to 6s — longer than the
     ~4.3s JS sequence so it never preempts it. -->
<meta http-equiv="refresh" content="6;url=${target_url}">
<link rel="canonical" href="${target_url}">
<style>
  :root{ --mask:#0a2a1a; --cop:#f4d27a; --mesh:#3ecf6e; --silk:#e9f5ec; --dim:#9dc7ac; }
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%}
  body{
    background:
      radial-gradient(120% 90% at 20% 0%, #0d3826, transparent 55%),
      radial-gradient(120% 120% at 100% 100%, #072116, transparent 60%),
      var(--mask);
    color:var(--silk); overflow:hidden;
    font-family:"Courier New",ui-monospace,monospace;
    display:flex; align-items:center; justify-content:center; text-align:center;
  }
  .scan{position:fixed;inset:0;pointer-events:none;mix-blend-mode:multiply;
    background:repeating-linear-gradient(0deg,rgba(0,0,0,.28) 0 1px,transparent 1px 3px)}
  .wrap{position:relative;z-index:2;padding:24px;max-width:760px}
  .kick{font-size:13px;letter-spacing:.30em;color:var(--dim);font-weight:700}
  .title{font-family:"Arial Black",Impact,sans-serif;font-size:clamp(64px,19vw,150px);
    letter-spacing:.08em;color:var(--cop);line-height:.9;margin-top:8px;
    text-shadow:0 2px 0 #7a5410, 0 0 26px rgba(244,210,122,.5)}
  .sub{margin-top:8px;font-size:clamp(13px,3.6vw,17px);letter-spacing:.16em;color:var(--silk)}
  .term{margin-top:20px;font-size:clamp(12px,3.4vw,15px);color:var(--mesh);
    text-shadow:0 0 8px rgba(62,207,110,.5);min-height:1.4em}
  .term .cursor{display:inline-block;width:.6em;background:var(--mesh);animation:blink 1s steps(1) infinite}
  @keyframes blink{50%%{opacity:0}}
  .count{margin-top:18px;font-family:"Arial Black",sans-serif;font-size:20px;letter-spacing:.10em;color:var(--silk)}
  .count b{color:var(--cop);font-size:26px}
  .bar{margin:12px auto 0;width:min(380px,82vw);height:9px;border:1px solid rgba(244,210,122,.5);
    border-radius:6px;overflow:hidden;background:rgba(10,40,26,.6)}
  .bar>i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--mesh),var(--cop));
    box-shadow:0 0 14px rgba(244,210,122,.7);animation:fill 3s linear forwards}
  @keyframes fill{to{width:100%}}
  /* reveal beat */
  .reveal{margin-top:16px;animation:pop .34s ease-out both}
  .reveal .rbig{font-family:"Arial Black",Impact,sans-serif;font-size:clamp(40px,11vw,82px);
    letter-spacing:.02em;line-height:.96;color:var(--cop);
    text-shadow:0 2px 0 #7a5410, 0 0 26px rgba(244,210,122,.5)}
  .reveal .rsub{margin-top:12px;font-size:clamp(13px,3.6vw,18px);letter-spacing:.12em;color:var(--mesh)}
  @keyframes pop{0%%{transform:scale(.7);opacity:0}60%%{transform:scale(1.06)}100%%{transform:scale(1);opacity:1}}
  .foot{margin-top:20px;font-size:12px;letter-spacing:.14em;color:var(--dim)}
  .foot a{color:var(--cop);text-decoration:none}
  @media (prefers-reduced-motion:reduce){.bar>i{animation:none;width:100%}.term .cursor{animation:none}.reveal{animation:none}}
</style>
</head>
<body>
  <div class="scan"></div>
  <div class="wrap">
    <div class="kick">DC34-SAO-01 &middot; SIMPLE ADD-ON &middot; v1.69bis</div>
    <div class="title">SAO</div>
    <div class="sub" id="sub">&#9642; MOUNTING SIMPLE ADD-ON</div>
    <div id="boot">
      <div class="term" id="term">i2c: probing 0x69<span class="cursor">&nbsp;</span></div>
      <div class="count">INITIALIZING &middot; <b id="n">3</b></div>
      <div class="bar"><i></i></div>
    </div>
    <div class="reveal" id="reveal" hidden>
      <div class="rbig">IT&rsquo;S THE BIB.</div>
      <div class="rsub">RUN BIB #34 &middot; lace up, Vegas &#127939;</div>
    </div>
    <div class="foot"><a href="${target_url}">skip &rsaquo;</a> &nbsp;&middot;&nbsp; sao.defcon.run</div>
  </div>
<script>
  // Covert CTF award (opt-in per host via covert_v): a signed-in visitor earns
  // the encoded challenge just by landing here. SAME proven mechanism as the apex
  // "!!!" egg — a <link rel=stylesheet> to run.human's covert channel (the shared
  // .defcon.run SSO cookie rides this same-site subresource; defcon.run and
  // run.defcon.run are same-site). The award is read back via
  // getComputedStyle(--accent-ramp) — a signed-in win gets a confetti burst; an
  // anonymous visitor gets nothing, silently. Empty covert_v ⇒ inert (no request).
  // COVERT_V is pinned by ctf-covert-codec.test.ts (SAO_SPLASH_COVERT_V).
  (function () {
    var COVERT_V = ${covert_v_json};
    if (!COVERT_V) return;
    var ENDPOINT = "https://run.defcon.run/use1/assets/theme", AWARD_PROP = "--accent-ramp";
    function celebrate() {
      var EMO = ["🎉", "🚩", "🩸", "🟩", "✨"];
      for (var i = 0; i < 30; i++) (function () {
        var s = document.createElement("span");
        s.textContent = EMO[(Math.random() * EMO.length) | 0];
        s.style.cssText = "position:fixed;left:50%;top:44%;z-index:99999;pointer-events:none;user-select:none;font-size:" + (18 + Math.random() * 24) + "px";
        document.body.appendChild(s);
        var ang = Math.random() * Math.PI * 2, dist = 140 + Math.random() * 280;
        var dx = Math.cos(ang) * dist, dy = Math.sin(ang) * dist - 140;
        var anim = s.animate([
          { transform: "translate(-50%,-50%) translate(0,0) rotate(0deg)", opacity: 1 },
          { transform: "translate(-50%,-50%) translate(" + dx + "px," + dy + "px) rotate(" + ((Math.random() * 720) - 360) + "deg)", opacity: 0 }
        ], { duration: 1100 + Math.random() * 800, easing: "cubic-bezier(.15,.7,.3,1)" });
        anim.onfinish = function () { s.remove(); };
      })();
    }
    var done = false, timer = null, link = document.createElement("link");
    function finish() {
      if (done) return; done = true;
      if (timer) clearTimeout(timer);
      var award = "";
      try { award = getComputedStyle(document.documentElement).getPropertyValue(AWARD_PROP).trim(); } catch (e) {}
      try { link.remove(); } catch (e) {}
      var n = Number(award);
      if (award !== "" && isFinite(n) && n > 0) celebrate();
    }
    link.rel = "stylesheet";
    link.href = ENDPOINT + "?v=" + COVERT_V + "&_=" + Date.now().toString(36);
    link.addEventListener("load", finish);
    link.addEventListener("error", finish);
    timer = setTimeout(finish, 1500);
    document.head.appendChild(link);
  })();

  var TARGET = ${target_url_json};
  var lines = ["i2c: probing 0x69 ... device found", "meshtastic: pairing node ...", "mounting add-on ..."];
  var term = document.getElementById("term"), nEl = document.getElementById("n");
  var sub = document.getElementById("sub"), boot = document.getElementById("boot"), reveal = document.getElementById("reveal");
  var i = 0;
  var lt = setInterval(function(){
    i++;
    if (i < lines.length) { term.innerHTML = lines[i] + '<span class="cursor">&nbsp;</span>'; }
  }, 900);
  var n = 3;
  var ct = setInterval(function(){
    n--;
    if (n <= 0) {
      clearInterval(ct); clearInterval(lt);
      sub.innerHTML = "&#10003; ADD-ON MOUNTED";
      boot.hidden = true; reveal.hidden = false;
      setTimeout(function(){ location.replace(TARGET); }, 1300);
    } else { nEl.textContent = n; }
  }, 1000);
</script>
</body>
</html>
