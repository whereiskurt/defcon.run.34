{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Local: DynamoDB",
      "type": "shell",
      "command": "docker compose down && docker compose up",
      "options": {
        "cwd": "${workspaceFolder}/apps/local/dynamodb"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "local-infra"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
