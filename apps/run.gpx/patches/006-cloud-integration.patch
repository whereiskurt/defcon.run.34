+<script lang="ts">
+    import { onMount } from 'svelte';
+    import * as Dialog from '$lib/components/ui/dialog/index.js';
+    import { Button } from '$lib/components/ui/button';
+    import {
+        Cloud,
+        CloudUpload,
+        CloudDownload,
+        Trash2,
+        RefreshCw,
+        Loader2,
+        AlertCircle,
+    } from '@lucide/svelte';
+    import {
+        cloudFiles,
+        cloudSyncStatus,
+        cloudSyncError,
+        listCloudFiles,
+        saveToCloud,
+        loadFromCloud,
+        deleteFromCloud,
+        type CloudFile,
+    } from '$lib/cloud-sync';
+    import { auth, isAuthenticated, hasGpxStudioAccess } from '$lib/stores/auth';
+    import { fileStateCollection } from '$lib/logic/file-state';
+    import { fileActions } from '$lib/logic/file-actions';
+    import { selection } from '$lib/logic/selection';
+    import { parseGPX } from 'gpx';
+    import { get } from 'svelte/store';
+
+    export let open = false;
+
+    let loading = false;
+    let error: string | null = null;
+
+    onMount(async () => {
+        // Check auth and load files on mount
+        await auth.checkSession();
+        if (get(isAuthenticated) && get(hasGpxStudioAccess)) {
+            await refreshFiles();
+        }
+    });
+
+    async function refreshFiles() {
+        loading = true;
+        error = null;
+        try {
+            await listCloudFiles();
+        } catch (e) {
+            error = e instanceof Error ? e.message : 'Failed to load files';
+        } finally {
+            loading = false;
+        }
+    }
+
+    async function handleLoadFile(file: CloudFile) {
+        loading = true;
+        error = null;
+        try {
+            const { content, fileName } = await loadFromCloud(file.fileId);
+            const gpx = parseGPX(content);
+            if (gpx.metadata === undefined) {
+                gpx.metadata = {};
+            }
+            if (!gpx.metadata.name) {
+                gpx.metadata.name = fileName.replace(/\.gpx$/i, '');
+            }
+            const id = fileActions.add(gpx);
+            selection.selectFileWhenLoaded(gpx._data.id);
+            open = false;
+        } catch (e) {
+            error = e instanceof Error ? e.message : 'Failed to load file';
+        } finally {
+            loading = false;
+        }
+    }
+
+    async function handleSaveCurrentFiles() {
+        loading = true;
+        error = null;
+        try {
+            const selectedItems = get(selection);
+            if (selectedItems.size === 0) {
+                // Save all files if none selected
+                fileStateCollection.forEach((fileId, file) => {
+                    const gpxContent = file.toString();
+                    const fileName = file.metadata?.name || `track-${fileId}.gpx`;
+                    saveToCloud(gpxContent, `${fileName}.gpx`, {
+                        trackCount: file.trk?.length || 0,
+                        waypointCount: file.wpt?.length || 0,
+                    });
+                });
+            } else {
+                // Save selected files
+                for (const [item] of selectedItems) {
+                    if (item.type === 'file') {
+                        const file = fileStateCollection.getFile(item.id);
+                        if (file) {
+                            const gpxContent = file.toString();
+                            const fileName = file.metadata?.name || `track-${item.id}.gpx`;
+                            await saveToCloud(gpxContent, `${fileName}.gpx`, {
+                                trackCount: file.trk?.length || 0,
+                                waypointCount: file.wpt?.length || 0,
+                            });
+                        }
+                    }
+                }
+            }
+            await refreshFiles();
+        } catch (e) {
+            error = e instanceof Error ? e.message : 'Failed to save files';
+        } finally {
+            loading = false;
+        }
+    }
+
+    async function handleDeleteFile(file: CloudFile) {
+        if (!confirm(`Delete "${file.fileName}" from cloud storage?`)) {
+            return;
+        }
+        loading = true;
+        error = null;
+        try {
+            await deleteFromCloud(file.fileId);
+        } catch (e) {
+            error = e instanceof Error ? e.message : 'Failed to delete file';
+        } finally {
+            loading = false;
+        }
+    }
+
+    function formatFileSize(bytes: number): string {
+        if (bytes < 1024) return `${bytes} B`;
+        if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
+        return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
+    }
+
+    function formatDate(timestamp: number): string {
+        return new Date(timestamp).toLocaleDateString(undefined, {
+            year: 'numeric',
+            month: 'short',
+            day: 'numeric',
+            hour: '2-digit',
+            minute: '2-digit',
+        });
+    }
+</script>
+
+<Dialog.Root bind:open>
+    <Dialog.Content class="max-w-2xl">
+        <Dialog.Header>
+            <Dialog.Title class="flex items-center gap-2">
+                <Cloud class="h-5 w-5" />
+                Cloud Storage
+            </Dialog.Title>
+            <Dialog.Description>
+                Save and load GPX files from your DEF CON cloud storage.
+            </Dialog.Description>
+        </Dialog.Header>
+
+        {#if !$isAuthenticated}
+            <div class="flex flex-col items-center justify-center py-8 text-center">
+                <AlertCircle class="h-12 w-12 text-muted-foreground mb-4" />
+                <p class="text-muted-foreground mb-4">You need to sign in to access cloud storage.</p>
+                <Button on:click={() => auth.login()}>Sign In</Button>
+            </div>
+        {:else if !$hasGpxStudioAccess}
+            <div class="flex flex-col items-center justify-center py-8 text-center">
+                <AlertCircle class="h-12 w-12 text-destructive mb-4" />
+                <p class="text-destructive mb-4">Access denied. You need the gpxstudio service.</p>
+                <p class="text-muted-foreground text-sm">Contact an admin to request access.</p>
+            </div>
+        {:else}
+            <div class="space-y-4">
+                <!-- Actions -->
+                <div class="flex gap-2">
+                    <Button
+                        variant="outline"
+                        size="sm"
+                        on:click={refreshFiles}
+                        disabled={loading}
+                    >
+                        {#if loading}
+                            <Loader2 class="h-4 w-4 mr-2 animate-spin" />
+                        {:else}
+                            <RefreshCw class="h-4 w-4 mr-2" />
+                        {/if}
+                        Refresh
+                    </Button>
+                    <Button
+                        variant="default"
+                        size="sm"
+                        on:click={handleSaveCurrentFiles}
+                        disabled={loading}
+                    >
+                        <CloudUpload class="h-4 w-4 mr-2" />
+                        Save Current to Cloud
+                    </Button>
+                </div>
+
+                <!-- Error message -->
+                {#if error}
+                    <div class="bg-destructive/10 text-destructive px-4 py-2 rounded-md text-sm">
+                        {error}
+                    </div>
+                {/if}
+
+                <!-- File list -->
+                <div class="border rounded-md max-h-96 overflow-auto">
+                    {#if $cloudFiles.length === 0}
+                        <div class="p-8 text-center text-muted-foreground">
+                            <Cloud class="h-12 w-12 mx-auto mb-4 opacity-50" />
+                            <p>No files in cloud storage yet.</p>
+                            <p class="text-sm mt-2">Save your current GPX files to get started.</p>
+                        </div>
+                    {:else}
+                        <table class="w-full">
+                            <thead class="bg-muted/50 sticky top-0">
+                                <tr>
+                                    <th class="text-left px-4 py-2 font-medium">Name</th>
+                                    <th class="text-left px-4 py-2 font-medium">Size</th>
+                                    <th class="text-left px-4 py-2 font-medium">Updated</th>
+                                    <th class="text-right px-4 py-2 font-medium">Actions</th>
+                                </tr>
+                            </thead>
+                            <tbody>
+                                {#each $cloudFiles as file}
+                                    <tr class="border-t hover:bg-muted/30">
+                                        <td class="px-4 py-2">
+                                            <span class="font-medium">{file.fileName}</span>
+                                            {#if file.trackCount}
+                                                <span class="text-xs text-muted-foreground ml-2">
+                                                    {file.trackCount} track{file.trackCount !== 1 ? 's' : ''}
+                                                </span>
+                                            {/if}
+                                        </td>
+                                        <td class="px-4 py-2 text-sm text-muted-foreground">
+                                            {formatFileSize(file.fileSize)}
+                                        </td>
+                                        <td class="px-4 py-2 text-sm text-muted-foreground">
+                                            {formatDate(file.updatedAt)}
+                                        </td>
+                                        <td class="px-4 py-2 text-right">
+                                            <div class="flex gap-1 justify-end">
+                                                <Button
+                                                    variant="ghost"
+                                                    size="icon"
+                                                    class="h-8 w-8"
+                                                    on:click={() => handleLoadFile(file)}
+                                                    disabled={loading}
+                                                    title="Load file"
+                                                >
+                                                    <CloudDownload class="h-4 w-4" />
+                                                </Button>
+                                                <Button
+                                                    variant="ghost"
+                                                    size="icon"
+                                                    class="h-8 w-8 text-destructive hover:text-destructive"
+                                                    on:click={() => handleDeleteFile(file)}
+                                                    disabled={loading}
+                                                    title="Delete file"
+                                                >
+                                                    <Trash2 class="h-4 w-4" />
+                                                </Button>
+                                            </div>
+                                        </td>
+                                    </tr>
+                                {/each}
+                            </tbody>
+                        </table>
+                    {/if}
+                </div>
+            </div>
+        {/if}
+
+        <Dialog.Footer>
+            <Button variant="outline" on:click={() => (open = false)}>Close</Button>
+        </Dialog.Footer>
+    </Dialog.Content>
+</Dialog.Root>
