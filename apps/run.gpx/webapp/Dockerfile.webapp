# Multi-stage Dockerfile for run.gpx
# Stage 1: Build gpx.studio frontend
# Stage 2: Build Next.js webapp
# Stage 3: Production runtime
#
# NOTE: Build context must be apps/run.gpx/ (not webapp/) to include gpx-studio submodule

# =============================================================================
# Stage 1: Build gpx.studio frontend (SvelteKit)
# =============================================================================
FROM node:20-alpine AS gpx-builder

# Region arg for BASE_PATH (e.g., use1, cac1)
ARG REGION_SHORT="use1"

# Mapbox token for map rendering (public, safe to embed in client bundle)
ARG PUBLIC_MAPBOX_TOKEN=""

WORKDIR /gpx

# First build the gpx library (it has typescript as devDependency and postinstall needs it)
COPY gpx-studio/gpx/package*.json ./
RUN npm install --ignore-scripts
COPY gpx-studio/gpx ./
RUN npm run build

# Now build the website
WORKDIR /gpx-studio

COPY gpx-studio/website/package*.json ./
# Use --ignore-scripts since we already built ../gpx above
RUN npm install --ignore-scripts

COPY gpx-studio/website ./

# Auth store + cloud-sync.ts come from the committed repo source (COPY'd above).
# The committed src/lib/stores/auth.ts is the single source of truth: it exports the
# full surface the studio imports (auth, currentUser, isAuthenticated, hasGpxStudioAccess,
# ...) and does SvelteKit base-path routing (base.replace('/studio','') + '/api/auth').
# Do NOT reintroduce an inline heredoc copy here — a divergent copy silently omitted
# `currentUser` and broke every run.gpx build from ~v0.0.18 until it was caught.

# Note: API base path fixes are now in the source files:
# - Map.svelte uses base.replace('/studio', '') for mapbox-token endpoint
# - CloudStorage.svelte uses getApiBase() from cloud-sync.ts for shares endpoint
# - ShareDialog.svelte uses getApiBase() from cloud-sync.ts
# - ShareAcceptDialog.svelte uses getApiBase() from cloud-sync.ts
# - share/[token]/+page.svelte uses API_BASE and AUTH_BASE with base path

# Build gpx.studio with regional BASE_PATH (e.g., /use1/studio)
# PUBLIC_MAPBOX_TOKEN is required for map rendering - get from build arg or provide placeholder for dev
# NODE_OPTIONS limits heap to prevent OOM kills in constrained Docker environments
ENV PUBLIC_MAPBOX_TOKEN=${PUBLIC_MAPBOX_TOKEN:-pk.placeholder}
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN BASE_PATH=/${REGION_SHORT}/studio npm run build

# =============================================================================
# Stage 2: Build Next.js webapp
# =============================================================================
FROM node:20-alpine AS webapp-builder

RUN apk update && apk add --no-cache \
    curl \
    build-base \
    g++ \
    python3

WORKDIR /app

# Copy package files and install dependencies (paths relative to apps/run.gpx/ build context)
COPY webapp/package*.json ./
RUN npm install

# Copy webapp source
COPY webapp/ .

# Copy built gpx.studio to public folder
COPY --from=gpx-builder /gpx-studio/build ./public/studio/

# Build arguments for Next.js
ARG NEXT_PUBLIC_ASSET_PREFIX=""
ARG WEBAPP_PREFIX="use1/assets"
ARG WEBAPP_ORIGIN="gpx.defcon.run"
ARG VERSION_WEBAPP="unknown"
ARG REGION_SHORT="use1"

ENV NEXT_PUBLIC_ASSET_PREFIX=$NEXT_PUBLIC_ASSET_PREFIX
ENV WEBAPP_PREFIX=$WEBAPP_PREFIX
ENV WEBAPP_ORIGIN=$WEBAPP_ORIGIN
ENV NEXT_PUBLIC_VERSION_APP=$VERSION_WEBAPP
ENV REGION_SHORT=$REGION_SHORT

# Build Next.js
RUN npm run build

# =============================================================================
# Stage 3: Production runtime
# =============================================================================
FROM node:20-alpine AS runner

WORKDIR /app

# Install curl for health checks
RUN apk add --no-cache curl

# Copy built artifacts
COPY --from=webapp-builder /app/.next/standalone ./
COPY --from=webapp-builder /app/.next/static ./.next/static
COPY --from=webapp-builder /app/public ./public

# Note: Health check handled by ECS task definition (uses regional path)
# Dockerfile HEALTHCHECK removed - basePath makes static health check path impossible

# Run as non-root user
USER node

EXPOSE 3000

CMD ["node", "server.js"]
