# run.bib webapp — local development environment example.
# Copy to .env.local for local dev; values must be provided.

# Public URL of the run.bib webapp (production: https://bib.defcon.run)
BIB_PUBLIC_URL=

# Local dev port for the run.bib Next.js server
LOCAL_BIB_PORT=3004

# JWT signing secret(s) for Auth.js session tokens.
# Comma-separated list supports rotation (first entry used for new sessions).
AUTH_JWT_SECRET=

# OIDC client credentials issued by run.auth for the `bib` client
OIDC_CLIENT_ID=bib
OIDC_CLIENT_SECRET=

# Shared secret used for server-to-server calls between run.bib and run.auth
AUTH_INTERNAL_SECRET=

# Shared DynamoDB table (run-human-electro) — same values as run.human
RUN_ELECTRO_ID=
RUN_ELECTRO_SECRET=
RUN_ELECTRO_REGION=us-east-1
RUN_ELECTRO_DBNAME=run-human-electro

# Optional overrides (only set to point at a non-default endpoint)
# RUN_ELECTRO_ENDPOINT=http://localhost:8000
