# DEF CON 34 CMS - Development Dockerfile
# Simple container that runs `npm run develop`

FROM node:22-alpine

WORKDIR /app

# Install build dependencies for native modules (better-sqlite3)
RUN apk add python3 make g++

# Copy all source files (respects .dockerignore)
COPY . .

# Install dependencies
RUN npm ci

EXPOSE 1337

ENV HOST=0.0.0.0 \
    PORT=1337

CMD ["npm", "run", "develop"]
