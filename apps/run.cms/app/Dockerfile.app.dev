# DEF CON 34 CMS - Development Dockerfile
# Simple container that runs `npm run develop`

FROM node:22-alpine

WORKDIR /app

# Install build dependencies for native modules (better-sqlite3)
RUN apk add --no-cache python3 make g++

# Copy package files and scripts needed for postinstall
COPY package*.json ./
COPY scripts/ ./scripts/

# Install dependencies
RUN npm ci

# Source code is mounted via volume in docker-compose
# This allows hot-reloading during development

EXPOSE 1337

ENV HOST=0.0.0.0 \
    PORT=1337

CMD ["npm", "run", "develop"]
