# Stage 1: Resolve current stable, vendor factory images, regenerate ESP32 device list
FROM node:current-alpine AS firmware
RUN apk add --no-cache curl unzip jq
WORKDIR /firmware

# Optional rollback / hotfix pin. When empty, the version is resolved from
# api.meshtastic.org/github/firmware/list (releases.stable[0].id). No hardcoded
# fallback — API unreachable + no build-arg = build fails.
ARG FIRMWARE_VERSION=""

RUN FW_VER="${FIRMWARE_VERSION}"; \
    if [ -z "$FW_VER" ]; then \
      FW_VER=$(curl -fsSL https://api.meshtastic.org/github/firmware/list \
        | jq -r '.releases.stable[0].id' \
        | sed 's/^v//'); \
    fi; \
    if [ -z "$FW_VER" ] || [ "$FW_VER" = "null" ]; then \
      echo "ERROR: Could not resolve Meshtastic stable version from api.meshtastic.org and no --build-arg FIRMWARE_VERSION provided" && exit 1; \
    fi; \
    echo "Resolved Meshtastic stable: ${FW_VER}" && \
    RELEASE_TAG="v${FW_VER}" && \
    BASE_URL="https://github.com/meshtastic/firmware/releases/download/${RELEASE_TAG}" && \
    for ARCH in esp32 esp32s3 esp32c3 esp32c6; do \
      ZIP="firmware-${ARCH}-${FW_VER}.zip"; \
      echo "Downloading ${ZIP}..." && \
      curl -fL -o "/tmp/${ZIP}" "${BASE_URL}/${ZIP}" || { echo "Warning: ${ZIP} not found"; continue; }; \
      unzip -q -o "/tmp/${ZIP}" "firmware-*.factory.bin" -d /firmware/ 2>/dev/null || true; \
      rm -f "/tmp/${ZIP}"; \
    done && \
    find /firmware -name "*-update.bin" -delete && \
    echo "Extracted $(find /firmware -name 'firmware-*.factory.bin' | wc -l) firmware binaries" && \
    echo "${FW_VER}" > /firmware/VERSION.txt

# Regenerate ESP32-only device hardware list (DEVC-06). Overwrites the tracked
# public/data/hardware-list.json snapshot when copied into Stage 2.
RUN mkdir -p /hardware && \
    curl -fsSL https://api.meshtastic.org/resource/deviceHardware \
      | jq '[.[] | select(.architecture == "esp32" or .architecture == "esp32-s3" or .architecture == "esp32-c3" or .architecture == "esp32-c6")]' \
      > /hardware/hardware-list.json && \
    jq -e 'length > 0' /hardware/hardware-list.json

# Stage 2: Build Next.js app
FROM node:current-alpine AS builder

RUN apk update && apk add --no-cache \
      sudo \
      curl \
      build-base \
      g++ \
      libpng \
      libpng-dev \
      jpeg-dev \
      pango-dev \
      cairo-dev \
      giflib-dev \
      python3 \
      ;

WORKDIR /app

COPY package*.json ./
RUN npm install
COPY . .

# Copy firmware binaries into public/firmware/ for build.sh S3 extraction
COPY --from=firmware /firmware/ ./public/firmware/

ARG NEXT_PUBLIC_ASSET_PREFIX=""
ARG WEBAPP_PREFIX="use1/assets"
ARG WEBAPP_ORIGIN="flash.defcon.run"
ARG VERSION_NGINX="unknown"
ARG VERSION_WEBAPP="unknown"
ARG REGION_SHORT="use1"
ENV NEXT_PUBLIC_ASSET_PREFIX=$NEXT_PUBLIC_ASSET_PREFIX
ENV WEBAPP_PREFIX=$WEBAPP_PREFIX
ENV WEBAPP_ORIGIN=$WEBAPP_ORIGIN
ENV NEXT_PUBLIC_VERSION_NGINX=$VERSION_NGINX
ENV NEXT_PUBLIC_VERSION_APP=$VERSION_WEBAPP
ENV REGION_SHORT=$REGION_SHORT

RUN npm run build

# Stage 3: Production runtime
FROM node:current-alpine AS runner
WORKDIR /app

# Install curl for health checks
RUN apk add --no-cache curl

# Only copy what's needed
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

USER node
EXPOSE 3000
CMD ["node", "server.js"]
