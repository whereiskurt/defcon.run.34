# Ignore meshtk Go source (copied at build time from ~/working/meshtk)
meshtk/*
!meshtk/Dockerfile.meshtk
!meshtk/VERSION
!meshtk/meshtk.dc34.yaml
!meshtk/meshtk.localdev.yaml
!meshtk/nodes.ghost.*.json
!meshtk/nodes.rabbit.*.json
# Con embedded GPX (overlaid onto a fresh generic meshtk clone at build time)
!meshtk/internal/
!meshtk/internal/app/
!meshtk/internal/app/server/*.go
!meshtk/internal/embedded/
!meshtk/internal/embedded/gpx/
!meshtk/internal/embedded/gpx/embedded.go
!meshtk/internal/embedded/gpx/*/
!meshtk/internal/embedded/gpx/*/*.gpx
# Con-specific fleet tests. Must be TRACKED, not just present: build.sh's CI
# overlay is built from `git ls-files`, so an untracked test would be discarded
# by the fresh-clone step and never run.
!meshtk/internal/app/fleet/
!meshtk/internal/app/fleet/gpx_routes_test.go
